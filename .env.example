# Groq API (chat + embeddings when EMBEDDING_PROVIDER=groq)
GROQ_API_KEY=your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Domain: education | healthcare | banking | legal | engineering
DOMAIN=education

# Language: en | ta | hi
DEFAULT_LANGUAGE=en

# Embeddings: groq (default, HTTP nomic on Groq — no PyTorch on server) | local
EMBEDDING_PROVIDER=groq
GROQ_EMBED_MODEL=nomic-embed-text-v1.5

# If true, when Groq returns model_not_found for Nomic embeds, use local sentence-transformers if installed.
EMBEDDING_GROQ_FALLBACK_LOCAL=true

# Used when EMBEDDING_PROVIDER=local or as Groq fallback (pip install -r requirements-local-embed.txt)
EMBED_MODEL=all-MiniLM-L6-v2
